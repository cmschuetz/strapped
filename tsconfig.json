{
  // Provenance: generated by `bun init` (bun 1.3.14) and adopted verbatim,
  // minus `jsx` (no JSX) and `allowJs` (there is no JavaScript under this
  // include to check — the committed deployables are generated from src/ and
  // `tests/build-sync.test.ts` runs `bun tools/build.ts --check` to keep them
  // honest). `tsc --noEmit` covers src/, tools/, and every test.
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src", "tools", "tests/**/*.ts"]
}
